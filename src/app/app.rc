#include <windows.h>
#include "resource.h"
#include "core/version.h"

// Application icon (16..256 px), generated by tools\make_icon.ps1 from the mark in assets\brand\moonsr_mark.svg.
IDI_APPICON ICON "../../assets/brand/moonsr.ico"


VS_VERSION_INFO VERSIONINFO
FILEVERSION MOONSR_VERSION_RC
PRODUCTVERSION MOONSR_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MoonSR"
            VALUE "ProductName", "MoonSR"
            VALUE "CompanyName", "MoonDev"
            VALUE "LegalCopyright", "Copyright (c) 2026 MoonDev. MIT licence."
            VALUE "FileVersion", MOONSR_VERSION_STRING
            VALUE "ProductVersion", MOONSR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
